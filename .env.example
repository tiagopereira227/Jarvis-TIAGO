# Copy this file to ".env" and fill in your key.
# Without a key, JARVIS still runs in a limited offline mode (skills only).

# Your LLM provider API key (OpenAI by default).
JARVIS_API_KEY=

# Optional: override the model. Defaults to a small, fast model.
JARVIS_MODEL=gpt-4o-mini

# Optional: point at an OpenAI-compatible endpoint (e.g. a local server or
# another provider). Leave blank to use OpenAI's default.
JARVIS_BASE_URL=

# --- Voice output (text-to-speech) ---
# Backend: "auto" (macOS `say`, offline), "say", or "openai" (natural, needs key).
JARVIS_TTS_BACKEND=auto
# OpenAI voice name when backend is "openai" (e.g. onyx, alloy, echo, nova).
JARVIS_TTS_VOICE=onyx
# Local voice name for the OS speech engine (used when backend is auto/local).
#   macOS `say`: e.g. Daniel (British). Blank = system default.
#   Windows System.Speech: e.g. "Microsoft George Desktop". Blank = default.
JARVIS_SAY_VOICE=

# --- Storage ---
# Where JARVIS keeps persisted timers/alarms and the Spotify token cache.
# Blank = ~/.jarvis
JARVIS_STORE_DIR=

# --- Spotify Web API (optional; play any track by name) ---
# Create an app at https://developer.spotify.com/dashboard to get these.
# The redirect URI must exactly match one registered in your Spotify app.
# Leave blank to use local Spotify app control instead.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Spotify rejects "localhost" as insecure — use the loopback IP 127.0.0.1.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Wave 1 skills (all optional) ---
# Path to an .ics calendar file for the calendar skill (exported/subscribed).
# On macOS, leaving this blank falls back to Calendar.app.
JARVIS_ICS_PATH=
# Working directory for the dev-shell skill (run_command). Blank = current dir.
JARVIS_WORKDIR=

# --- Proactive briefing & alerts (spoken while the daemon runs) ---
# Morning briefing: weather + today's calendar + top news, spoken aloud.
JARVIS_BRIEFING_ENABLED=true
JARVIS_BRIEFING_TIME=09:30
# Home location for the briefing's weather line (blank = weather skipped).
JARVIS_HOME_LOCATION=
# Spoken heads-up before calendar events (needs a calendar source configured).
JARVIS_ALERTS_ENABLED=true
JARVIS_ALERT_LEAD_MINUTES=10

# --- Boot / auto-start ---
# On --boot, the dashboard opens in Google Chrome by default. Set this to a
# specific browser command to override (blank = Chrome, then OS default).
JARVIS_BROWSER=
